# Node
node_modules/
.next/
# The production build the performance pass measures beside a running `next dev` (P10.4),
# and the diagnostic scripts that prototyped its instruments.
.next-perf/
# A second Next build directory (VARUNA_DIST_DIR), e.g. a second, private dev server.
.next-*/
apps/command/.perf-*.mjs
out/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
coverage/
playwright-report/
test-results/
playwright-results.json

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
htmlcov/
.coverage*

# VARUNA data (regenerated by make city / bundle / bake)
city/*
!city/.gitkeep
!city/cache/.gitkeep
data/runs/*

# The weather proxy's last-good copy: a runtime cache of somebody else's data,
# rewritten every fifteen minutes (ADR-0061).
data/cache/

# Authority edits: an append-only operational log written at runtime, per deployment
# (ADR-0062). The demo's own closures are not somebody else's history.
data/ops/
!data/runs/.gitkeep

# Twin runs generated by `make train` to fit Flash-lite: 8 runs at ~24 MB each, and they are
# intermediate data rather than an artifact. The **fitted model** ships as demo/flash_lite.npz
# (~2 MB), which is what the API loads and what a deployment actually needs; regenerating the
# runs is one `make train` away.
data/train/
bundles/*/radar/
bundles/*/truth/
bundles/*/traffic/
*.zarr/
*.gpkg
*.tif
*.tiff

# Env / OS / editors
.env
.env.local
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
numba_cache/
packages/tokens/dist/

# Responsible disclosure: a live, unpatched credential exposure on a third-party
# government system. Publishing these would point people at an unfixed vulnerability.
# Report privately to CERT-In and the operator; publish only after it is fixed.
docs/SECURITY_FINDING_BMC.md
docs/disclosure_email_BMC.txt

# Verbatim copies of third-party news articles, kept locally as an audit trail.
# Republishing whole articles would redistribute copyrighted work; every claim in
# docs/research/*.md carries the live source_url and a short quoted excerpt instead.
docs/research/_raw/pages/
.vercel/

skills/

.vercel

# Reports arrive at runtime; the inbox is a runtime artifact, not source.
data/reports/

# Lighthouse CI output (generated; the HTML report embeds Google's own report template)
.lighthouseci/

# loaders.gl decoder workers, copied out of node_modules by `make workers` (which `pnpm dev` and
# `pnpm build` both run first). They are byte-for-byte copies of files pnpm install already
# places in node_modules, and a committed copy can outlive the dependency it came from: bump
# @loaders.gl/draco and the stale bundle in public/ keeps being served, which is the mismatch
# loaders.gl's own validateWorkerVersion complains about at run time. Generating them refuses that
# by construction, and an offline clone loses nothing, because it must run pnpm install before it
# can run Next at all.
apps/command/public/workers/
.wf/

# Stale runs set aside by hand (2026-09-26); kept locally, never committed.
data/runs-quarantine/

# Local what-if answers; the shipped copy lives in demo/whatif
data/whatif/

# Live-cycle forcing (varuna_cycle.live): refetched every cycle, never committed.
bundles/*-LIVE/
