{
  "$id": "urn:varuna:schema:SeriesPoint",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One time step of a fan chart (depth in cm).",
  "properties": {
    "lead_min": {
      "description": "Minutes from the cycle time; negative = observed half.",
      "title": "Lead Min",
      "type": "integer"
    },
    "observed": {
      "default": false,
      "description": "True for the observed (analysed) half.",
      "title": "Observed",
      "type": "boolean"
    },
    "p10_cm": {
      "minimum": 0,
      "title": "P10 Cm",
      "type": "number"
    },
    "p50_cm": {
      "minimum": 0,
      "title": "P50 Cm",
      "type": "number"
    },
    "p90_cm": {
      "minimum": 0,
      "title": "P90 Cm",
      "type": "number"
    },
    "valid_ts": {
      "format": "date-time",
      "title": "Valid Ts",
      "type": "string"
    }
  },
  "required": [
    "valid_ts",
    "lead_min",
    "p10_cm",
    "p50_cm",
    "p90_cm"
  ],
  "title": "SeriesPoint",
  "type": "object"
}
