{
  "$id": "urn:varuna:schema:SafeUntilEntry",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "enum": [
        "ambulance",
        "fire_tender",
        "bus",
        "car",
        "two_wheeler",
        "pedestrian"
      ],
      "title": "Profile",
      "type": "string"
    },
    "risk_tolerance": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Risk Tolerance",
      "type": "number"
    },
    "safe_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None = passable through the forecast horizon.",
      "title": "Safe Until"
    },
    "threshold_cm": {
      "exclusiveMinimum": 0,
      "title": "Threshold Cm",
      "type": "integer"
    }
  },
  "required": [
    "profile",
    "threshold_cm",
    "risk_tolerance"
  ],
  "title": "SafeUntilEntry",
  "type": "object"
}
