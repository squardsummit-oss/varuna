{
  "$defs": {
    "Isochrone": {
      "additionalProperties": false,
      "description": "Area reachable from a facility within ``minutes`` under the forecast.",
      "properties": {
        "area_km2": {
          "minimum": 0,
          "title": "Area Km2",
          "type": "number"
        },
        "minutes": {
          "enum": [
            5,
            10,
            15
          ],
          "title": "Minutes",
          "type": "integer"
        },
        "polygon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Concave hull of reached nodes; None when nothing is reachable.",
          "title": "Polygon"
        },
        "reachable_nodes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reachable Nodes"
        }
      },
      "required": [
        "minutes",
        "area_km2"
      ],
      "title": "Isochrone",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  {
                    "maxItems": 3,
                    "minItems": 3,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "Rings of positions; the first ring is the exterior. Rings must close (first == last).",
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                }
              ]
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    }
  },
  "$id": "urn:varuna:schema:ReachabilityResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``GET /v1/reachability`` and one feature group of ``reachability.geojson``.",
  "properties": {
    "dry_area_15_km2": {
      "description": "15-min catchment area with no flooding.",
      "minimum": 0,
      "title": "Dry Area 15 Km2",
      "type": "number"
    },
    "facility_id": {
      "minLength": 1,
      "title": "Facility Id",
      "type": "string"
    },
    "facility_kind": {
      "enum": [
        "hospital",
        "fire_station",
        "station",
        "transit",
        "school",
        "shelter"
      ],
      "title": "Facility Kind",
      "type": "string"
    },
    "facility_name": {
      "description": "e.g. KEM Hospital, Parel",
      "title": "Facility Name",
      "type": "string"
    },
    "isochrones": {
      "items": {
        "$ref": "#/$defs/Isochrone"
      },
      "title": "Isochrones",
      "type": "array"
    },
    "lat": {
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Lat",
      "type": "number"
    },
    "lon": {
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Lon",
      "type": "number"
    },
    "profile": {
      "enum": [
        "ambulance",
        "fire_tender",
        "bus",
        "car",
        "two_wheeler",
        "pedestrian"
      ],
      "title": "Profile",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "t": {
      "description": "Forecast slice the isochrones are computed for (IST).",
      "format": "date-time",
      "title": "T",
      "type": "string"
    },
    "valid_ts": {
      "description": "Cycle time of the run (IST).",
      "format": "date-time",
      "title": "Valid Ts",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "valid_ts",
    "t",
    "facility_id",
    "facility_name",
    "facility_kind",
    "lon",
    "lat",
    "profile",
    "dry_area_15_km2"
  ],
  "title": "ReachabilityResponse",
  "type": "object"
}
