{
  "$defs": {
    "LineString": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "anyOf": [
              {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              }
            ]
          },
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "LineString",
          "default": "LineString",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineString",
      "type": "object"
    },
    "RouteResult": {
      "additionalProperties": false,
      "description": "One route with its forecast-aware summary.",
      "properties": {
        "arrival_ts": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival Ts"
        },
        "distance_km": {
          "minimum": 0,
          "title": "Distance Km",
          "type": "number"
        },
        "eta_min": {
          "description": "Travel time in minutes under the forecast.",
          "minimum": 0,
          "title": "Eta Min",
          "type": "number"
        },
        "geometry": {
          "$ref": "#/$defs/LineString"
        },
        "label": {
          "default": "VARUNA",
          "enum": [
            "VARUNA",
            "Naive (shortest)",
            "Alternate"
          ],
          "title": "Label",
          "type": "string"
        },
        "max_expected_depth_cm": {
          "description": "Max p50 depth met along the route.",
          "minimum": 0,
          "title": "Max Expected Depth Cm",
          "type": "number"
        },
        "max_p_exceed": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Highest P(impassable) on any segment of the route.",
          "title": "Max P Exceed"
        },
        "safe_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Latest departure for which the route stays passable; None = horizon.",
          "title": "Safe Until"
        },
        "segment_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "geometry",
        "eta_min",
        "distance_km",
        "max_expected_depth_cm"
      ],
      "title": "RouteResult",
      "type": "object"
    }
  },
  "$id": "urn:varuna:schema:Corridor",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One of up to three safe roads a request may be spread across (TECH_SPEC 3.3, task D-08).\n\nThe corridors are real - each is a different road and each clears the profile's threshold on\nthis run. The ``share`` is **policy**: demand is not measured anywhere in this prototype, and\nevery response that carries corridors also carries that disclosure in ``notes``.",
  "properties": {
    "assigned": {
      "description": "True on the corridor this request was assigned to.",
      "title": "Assigned",
      "type": "boolean"
    },
    "capacity_score": {
      "description": "sum(lanes * (1 - congestion_proxy(depth))) over the corridor's edges.",
      "minimum": 0,
      "title": "Capacity Score",
      "type": "number"
    },
    "id": {
      "description": "Stable per road: a digest of the corridor's segment sequence.",
      "title": "Id",
      "type": "string"
    },
    "label": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Label",
      "type": "string"
    },
    "max_p_exceed": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Highest P(impassable) met on this corridor.",
      "title": "Max P Exceed"
    },
    "route": {
      "$ref": "#/$defs/RouteResult"
    },
    "share": {
      "description": "Fraction of requests policy sends this way.",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Share",
      "type": "number"
    }
  },
  "required": [
    "id",
    "label",
    "route",
    "share",
    "assigned",
    "capacity_score"
  ],
  "title": "Corridor",
  "type": "object"
}
