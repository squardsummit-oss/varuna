{
  "$id": "urn:varuna:schema:ErrorDetail",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``code`` is machine-readable; ``message`` says what happened and what to do.",
  "properties": {
    "code": {
      "description": "e.g. run_not_found",
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Code",
      "type": "string"
    },
    "details": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Details"
    },
    "message": {
      "description": "e.g. 'Run MUM-... is not baked yet. Press Play on the replay or Compute live.'",
      "title": "Message",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "ErrorDetail",
  "type": "object"
}
