{
  "$id": "urn:varuna:schema:TidalOutfall",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A coastal or creek outfall whose stage follows the tide (the demo's tide-locked outfall).",
  "properties": {
    "flap_gate": {
      "default": false,
      "description": "True blocks reverse flow.",
      "title": "Flap Gate",
      "type": "boolean"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "lat": {
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Lat",
      "type": "number"
    },
    "lon": {
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Lon",
      "type": "number"
    },
    "name": {
      "description": "e.g. Worli sea face outfall",
      "title": "Name",
      "type": "string"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    },
    "stage_source": {
      "default": "illustrative",
      "description": "'tide table <url>' when public tables were used, else 'illustrative'.",
      "title": "Stage Source",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "lon",
    "lat"
  ],
  "title": "TidalOutfall",
  "type": "object"
}
