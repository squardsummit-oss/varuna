{
  "meta": {
    "name": "VARUNA design tokens",
    "version": "1.0.0",
    "source": "SPEC.md section 6 (design system). Single source of truth for TypeScript and Python."
  },
  "color": {
    "base": {
      "ink": { "value": "#0A1020", "use": "app background" },
      "deep": { "value": "#111A2E", "use": "panels, rails, cards" },
      "well": { "value": "#17233B", "use": "inputs, hover rows, selected tabs" },
      "line": { "value": "#24314F", "use": "borders, dividers" },
      "line-strong": { "value": "#33436A", "use": "focused or emphasised borders" },
      "text": { "value": "#E3EAF6", "use": "primary text" },
      "text-2": { "value": "#A7B4CC", "use": "secondary text" },
      "text-3": { "value": "#7E8DA9", "use": "muted text, placeholders" },
      "tide": { "value": "#2DD4BF", "use": "brand accent: primary buttons, links, safe routes, VARUNA route, focus rings" },
      "tide-soft": { "value": "#0F3A3A", "use": "accent backgrounds" }
    },
    "depth": {
      "dry": { "value": "#2B3A55", "min_cm": 0, "max_cm": 5, "label": "< 5 cm", "meaning": "barely visible on the map" },
      "1": { "value": "#3B82F6", "min_cm": 5, "max_cm": 15, "label": "5-15 cm", "meaning": "two-wheelers slow" },
      "2": { "value": "#F59E0B", "min_cm": 15, "max_cm": 30, "label": "15-30 cm", "meaning": "two-wheelers impassable" },
      "3": { "value": "#F97316", "min_cm": 30, "max_cm": 45, "label": "30-45 cm", "meaning": "cars impassable" },
      "4": { "value": "#EF4444", "min_cm": 45, "max_cm": 60, "label": "45-60 cm", "meaning": "buses and trucks impassable" },
      "5": { "value": "#B91C1C", "min_cm": 60, "max_cm": null, "label": "> 60 cm", "meaning": "rescue vehicles only" }
    },
    "rain": {
      "1": { "value": "#21276B", "min_mm_h": 0.5, "max_mm_h": 2, "label": "0.5-2 mm/h", "meaning": "drizzle" },
      "2": { "value": "#2F3A9E", "min_mm_h": 2, "max_mm_h": 8, "label": "2-8 mm/h", "meaning": "light rain" },
      "3": { "value": "#4453D6", "min_mm_h": 8, "max_mm_h": 20, "label": "8-20 mm/h", "meaning": "moderate rain" },
      "4": { "value": "#6D79F0", "min_mm_h": 20, "max_mm_h": 40, "label": "20-40 mm/h", "meaning": "heavy rain, the lower nowcast exceedance threshold" },
      "5": { "value": "#9AA6F9", "min_mm_h": 40, "max_mm_h": 80, "label": "40-80 mm/h", "meaning": "very heavy rain, the upper nowcast exceedance threshold" },
      "6": { "value": "#CBD2FE", "min_mm_h": 80, "max_mm_h": null, "label": "> 80 mm/h", "meaning": "cloudburst" }
    },
    "drain": {
      "0": { "value": "#3E4C6E", "min_beta": 0.0, "max_beta": 0.25 },
      "1": { "value": "#7C3AED", "min_beta": 0.25, "max_beta": 0.5 },
      "2": { "value": "#C026D3", "min_beta": 0.5, "max_beta": 0.75 },
      "3": { "value": "#E879F9", "min_beta": 0.75, "max_beta": 1.0 }
    },
    "semantic": {
      "surcharge": { "value": "#EF4444", "use": "manhole surcharge markers, reversed-flow edges" },
      "naive": { "value": "#64748B", "use": "naive route (dashed), pre-update drain state, before states" },
      "truth": { "value": "#FFFFFF", "use": "ground-truth pins, with a tide ring" },
      "danger": { "value": "#F87171", "use": "destructive UI actions only; never on the map, never for depth" }
    },
    "reach": {
      "5": { "value": "#2DD4BF", "opacity": 0.45, "minutes": 5 },
      "10": { "value": "#2DD4BF", "opacity": 0.28, "minutes": 10 },
      "15": { "value": "#2DD4BF", "opacity": 0.14, "minutes": 15 }
    },
    "obs": {
      "traffic": { "value": "#FB7185" },
      "report": { "value": "#FDE68A" },
      "sensor": { "value": "#34D399" },
      "cctv": { "value": "#C4B5FD" },
      "sar": { "value": "#93C5FD" }
    },
    "status": {
      "live": { "value": "#22C55E" },
      "replay": { "value": "#38BDF8" },
      "baked": { "value": "#A78BFA" },
      "degraded": { "value": "#FBBF24" }
    },
    "chart": {
      "1": { "value": "#2DD4BF" },
      "2": { "value": "#60A5FA" },
      "3": { "value": "#F472B6" },
      "4": { "value": "#FBBF24" },
      "5": { "value": "#A3E635" }
    }
  },
  "probability": {
    "min_opacity": 0.15,
    "band_opacity": 0.2,
    "thresholds_cm": [15, 30, 45, 60]
  },
  "raster": {
    "depth_layer_opacity": 0.55,
    "note": "Depth raster PNGs are generated in Python from color.depth with the same thresholds so map pixels and UI chips match exactly."
  },
  "font": {
    "display": { "family": "Bricolage Grotesque", "fallback": "system-ui, sans-serif", "weights": [500, 600, 700], "tracking": "-0.02em", "line_height": [1.02, 1.1] },
    "sans": { "family": "Geist Sans", "fallback": "system-ui, -apple-system, Segoe UI, sans-serif", "weights": [400, 500, 600] },
    "mono": { "family": "Geist Mono", "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace", "use": "run IDs, CAP XML, API explorer, log streams only" },
    "indic": { "devanagari": "Noto Sans Devanagari", "tamil": "Noto Sans Tamil", "tier": "P1" }
  },
  "type_scale": {
    "micro": { "size": 12, "line_height": 1.3 },
    "small": { "size": 13, "line_height": 1.4 },
    "body": { "size": 15, "line_height": 1.5 },
    "h3": { "size": 18, "line_height": 1.35 },
    "h2": { "size": 24, "line_height": 1.2 },
    "h1": { "size": 32, "line_height": 1.15 },
    "display": { "size": 48, "line_height": 1.05 },
    "hero": { "size": 72, "line_height": 1.0 }
  },
  "radius": { "panel": 12, "control": 8, "chip": 999, "popover": 10, "phone": 40 },
  "space": { "grid": 4, "row": 40, "row_dense": 32, "panel_padding": 16, "section_gap": 24 },
  "layout": { "top_bar": 52, "time_bar": 96, "icon_rail": 56, "right_rail": 360, "reference": [1440, 900] },
  "glass": { "background": "#0A1020", "opacity": 0.72, "blur_px": 12, "allowed_on": "console time bar only" },
  "icon": { "row": 16, "nav": 20, "stroke": 1.75, "set": "lucide" },
  "motion": {
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "spring": { "stiffness": 400, "damping": 32 },
    "duration_ms": { "micro": 180, "micro_min": 150, "micro_max": 220, "panel": 300, "flight": 900, "draw_on_max": 1200 },
    "fly_to_curve": 1.4,
    "surcharge_pulse_ms": 1600
  },
  "focus": { "ring_color": "#2DD4BF", "ring_px": 2 }
}
