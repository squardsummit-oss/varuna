# ---- VARUNA runtime -------------------------------------------------------
VARUNA_CITY=mumbai
VARUNA_BUNDLE=MUM-2019-07-02
VARUNA_REPLAY_SPEED=30
# replay | live
VARUNA_MODE=replay
# 1 = block all outbound network (offline package / tests)
VARUNA_OFFLINE=0
# POST /v1/onboard (city-in-a-box). On for the demo laptop; the Railway image sets 0, because one
# public build filled the 500 MB volume and took the API down (2026-09-13).
VARUNA_ONBOARD_ENABLED=1
# Shared passphrase for the authority desk's writes (sent in the X-Varuna-Ops header). Empty
# means every write is refused and says why - a gate, not authentication. Set it on the demo
# laptop only; the deployed API leaves it empty and is read-only. An exported variable wins.
VARUNA_OPS_PASSPHRASE=
# Compute live (the console time bar): re-run the replay clock's current cycle with real
# computation, from whichever bundle the clock is on (the reconstructed 2019 replay unless /replay
# has switched it to a design storm; the time bar names which). `make dev` and `make demo` set 1
# for the API they start unless this line or the shell says otherwise; the API reads only its
# process environment, so a bare `uvicorn` stays off. Measured on the demo laptop: median about
# 104 s, 48-224 s over 8 runs, against section 14's 15 s, and the button prints the host's own
# figure before it is pressed.
# Railway keeps it off: a cycle holds most of the container's memory for a minute or more.
VARUNA_COMPUTE_LIVE=1
# What-if physics runs (the Kalpana lab's tide lever and "Run on the physics"): one full-city
# coupled Twin per scenario, about a minute on the demo laptop. On by default; the Railway image
# sets 0 and answers only the scenarios shipped pre-computed in demo/whatif/.
VARUNA_WHATIF_TWIN=1
# Citizen report photos: 1 stores each photo (EXIF and GPS stripped, re-encoded, at most 1280 px)
# and shows it to the ward officer and on the maps. The Railway image sets 0: public writes are
# for the demo laptop, and a report posted there is kept without its photo and says so.
VARUNA_REPORT_PHOTOS=1
# Total size of the stored photos in MB; past it a report is accepted without its photo.
VARUNA_REPORT_PHOTO_BUDGET_MB=100
VARUNA_API_PORT=8000
VARUNA_UI_PORT=3000

# ---- Next.js ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/v1/live
# CARTO dark matter, no labels (free with attribution)
NEXT_PUBLIC_BASEMAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-nolabels-gl-style/style.json

# ---- Optional providers (leave empty; fallbacks are built in) --------------
MAPPLS_KEY=
TOMTOM_KEY=
OPENTOPO_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
POSTGRES_URL=
REDIS_URL=

# ---- Tooling --------------------------------------------------------------
# uv on this machine needs the Windows certificate store for downloads
UV_SYSTEM_CERTS=1

# Public site URL, used to resolve Open Graph image URLs (defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
